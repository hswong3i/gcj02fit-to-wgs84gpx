{
  "dependencies": {
    "@garmin/fitsdk": "~21.208.0",
    "bootstrap": "~5.3.8",
    "bootstrap-icons": "~1.13.1",
    "chart.js": "~4.5.1",
    "github-fork-ribbon-css": "~0.2.3",
    "leaflet": "~1.9.4"
  },
  "devDependencies": {
    "eslint": "~10.8.0",
    "http-server": "~14.1.1",
    "prettier": "~3.9.6",
    "sass": "~1.101.0",
    "stylelint": "~16.26.1",
    "stylelint-config-standard-scss": "~16.0.0",
    "stylelint-config-twbs-bootstrap": "~16.1.0"
  },
  "scripts": {
    "build": "npm run pandoc && npm run eslint && npm run stylelint && npm run sass && npm run prettier",
    "eslint": "eslint --fix js/**/*.js *.js",
    "http-server": "http-server . -p 8000",
    "pandoc": "pandoc -f gfm -t gfm --wrap preserve -o DESIGN.md DESIGN.md",
    "prettier": "prettier --write *.html *.js js/**/*.js scss/**/*.scss css/**/*.css",
    "sass": "sass --no-source-map --style=expanded scss:css",
    "sass:watch": "sass --no-source-map --style=expanded --watch scss:css",
    "stylelint": "stylelint --fix scss/**/*.scss"
  },
  "type": "module",
  "version": "1.0.0"
}
