{
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "chromedriver@151.0.5": true
  },
  "dependencies": {
    "@garmin/fitsdk": "~21.208.0",
    "bootstrap": "~5.3.8",
    "bootstrap-icons": "~1.13.1",
    "chart.js": "~4.5.1",
    "github-fork-ribbon-css": "~0.2.3",
    "leaflet": "~1.9.4"
  },
  "devDependencies": {
    "eslint": "~8.57.1",
    "eslint-config-airbnb-base": "~15.0.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-formatter-gitlab": "~5.1.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jsdoc": "~61.7.1",
    "eslint-plugin-no-jquery": "~3.1.1",
    "eslint-plugin-no-unsanitized": "~4.0.0",
    "eslint-plugin-prettier": "~5.5.6",
    "eslint-plugin-security": "~1.7.1",
    "eslint-plugin-security-node": "~1.1.4",
    "eslint-plugin-yml": "~1.19.1",
    "http-server": "~14.1.1",
    "prettier": "~3.6.2",
    "sass": "~1.101.0",
    "stylelint": "~16.26.1",
    "stylelint-checkstyle-formatter": "~0.1.2",
    "stylelint-config-standard": "~38.0.0",
    "stylelint-config-standard-scss": "~16.0.0",
    "stylelint-order": "~7.0.1",
    "stylelint-prettier": "~5.0.3"
  },
  "scripts": {
    "build": "npm run pandoc && npm run eslint && npm run stylelint && npm run sass && npm run prettier",
    "eslint": "eslint --fix js/**/*.js",
    "http-server": "http-server . -p 8000",
    "pandoc": "for i in *.md; do pandoc -f gfm -t gfm --wrap preserve -o $i $i; done",
    "prettier": "prettier --write *.html js/**/*.js scss/**/*.scss",
    "sass": "sass --no-source-map --style=expanded --silence-deprecation=import --silence-deprecation=if-function --silence-deprecation=global-builtin --silence-deprecation=color-functions scss:css",
    "sass:watch": "sass --no-source-map --style=expanded --silence-deprecation=import --silence-deprecation=if-function --silence-deprecation=global-builtin --silence-deprecation=color-functions --watch scss:css",
    "stylelint": "stylelint --fix scss/**/*.scss"
  },
  "type": "module",
  "version": "20260810.1.5"
}
